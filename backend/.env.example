NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SWAGGER_ENABLED=true
S3_ENABLED=false
HTTP_REQUEST_LOG_ENABLED=false
TRUST_PROXY=false
# Production refuses false. The Playwright suite turns it off.
RATE_LIMIT_ENABLED=true
PHONE_DEFAULT_REGION=US
APP_NAME=Acme
# resend sends real mail. smtp sends to Mailpit from docker-compose, viewable at http://localhost:8025.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=Acme <noreply@example.com>
# Required when EMAIL_TRANSPORT=resend
RESEND_API_KEY=replace-with-a-resend-api-key
# Required when EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe1
SEED_ADMIN_NAME=Admin

# Required only when S3_ENABLED=true
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
