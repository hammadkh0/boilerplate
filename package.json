{
  "name": "boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Starting point for new client projects. NestJS backend and Next.js frontend.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "secretlint": "secretlint --secretlintrc .secretlintrc.json \"**/*\"",
    "audit:security": "node scripts/audit-security.mjs"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "secretlint": "^11.2.5"
  }
}
